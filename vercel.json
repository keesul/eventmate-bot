{
  "version": 2,
  "builds": [
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.cjs"
    },
    {
      "src": "/api/events/(.*)",
      "dest": "/api/events/[...params].cjs"
    },
    {
      "src": "/api/events",
      "dest": "/api/events/[...params].cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/webapp/$1"
    }
  ]
}
